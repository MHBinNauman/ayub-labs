# Copy to .env.local for local overrides. Nothing here is secret.

# Public origin for canonical URLs, Open Graph, sitemap, robots.txt and JSON-LD.
# Leave empty to use https://ayyublabs.com (brand.domain in src/data/site-data.ts).
# Must be an absolute https:// URL; it is inlined at BUILD time, so changing
# it on Vercel needs a redeploy. See DEPLOY.md before setting it.
NEXT_PUBLIC_SITE_URL=
